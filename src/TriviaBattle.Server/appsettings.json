{
  "ConnectionStrings": {
    "TriviaBattle": "Data Source=triviabattle.db"
  },
  "AdminApiKey": "",
  "Port": 5000,

  "Game": {
    "Format": "Dungeon",
    "MatchSeconds": 60,
    "IntroSeconds": 7,
    "ResultsSeconds": 10,
    "CorrectPoints": 100,
    "WrongAnswerPenalty": "Lockout",
    "LockoutSeconds": 2,
    "WrongAnswerPoints": 50,
    "NewQuestionGraceSeconds": 0.3,
    "ShuffleAnswers": true,
    "Arcade": {
      "_comment": "The arcade lobby at the stations: a party, race or battle waits JoinSeconds for players; a station left choosing IdleSeconds goes back to 'press any button'. HeroPhotos: the photo step after choosing a hero (PhotoSeconds from its start to the photo).",
      "JoinSeconds": 20,
      "LateJoinSeconds": 6,
      "IdleSeconds": 30,
      "Difficulty": "Easy",
      "HeroPhotos": true,
      "PhotoSeconds": 4
    }
  },

  "Display": {
    "DefaultTheme": "dungeon"
  },

  "Media": {
    "IntroVideoUrl": "",
    "IntroVideoDelaySeconds": 1
  },

  "Audio": {
    "Enabled": true,
    "OutputCount": 8,
    "SampleRate": 44100,
    "IntroSound": "",
    "LobbyMusic": "/media/audio/dungeon/idle_music.mp3",
    "AttractMusic": "/media/audio/dungeon/idle_music.mp3",
    "PlayingMusic": "/media/audio/dungeon/ingame_music.mp3",
    "VictoryMusic": "/media/audio/dungeon/end_music.mp3",
    "CorrectStingers": [
      "/media/audio/stingers/success_1.wav",
      "/media/audio/stingers/success_2.wav",
      "/media/audio/stingers/success_3.wav"
    ],
    "WrongStingers": [
      "/media/audio/stingers/fail_1.wav",
      "/media/audio/stingers/fail_2.wav",
      "/media/audio/stingers/fail_3.wav"
    ],
    "Dungeon": {
      "_comment": "Placeholder 8-bit effects made for the battle beats; replace the files (or point these at new ones) when real sounds exist.",
      "Hit": "/media/audio/dungeon/sfx/hit.wav",
      "Crit": "/media/audio/dungeon/sfx/crit.wav",
      "Kill": "/media/audio/dungeon/sfx/kill.wav",
      "Floor": "/media/audio/dungeon/sfx/floor.wav",
      "Boss": "/media/audio/dungeon/sfx/boss.wav",
      "PartyCombo": "/media/audio/dungeon/sfx/party-combo.wav",
      "Revive": "/media/audio/dungeon/sfx/revive.wav",
      "Hurt": "/media/audio/dungeon/sfx/hurt.wav",
      "Downed": "/media/audio/dungeon/sfx/downed.wav",
      "Block": "/media/audio/dungeon/sfx/block.wav",
      "Loot": "/media/audio/dungeon/sfx/loot.wav",
      "PowerUp": "/media/audio/dungeon/sfx/powerup.wav",
      "PhotoCountdown": "/media/audio/dungeon/sfx/photo-countdown.wav",
      "Photo": "/media/audio/dungeon/sfx/photo.wav"
    },
    "_BossMusic": "Dungeon: the room music while anyone fights a boss. Empty = the playing music carries on.",
    "BossMusic": "",
    "MusicVolume": 0.8,
    "AttractVolume": 0.8,
    "IntroVolume": 1,
    "StingerVolume": 1,
    "SubVolume": 1
  },

  "Leaderboards": {
    "Size": 10,
    "RegisteredPlayersOnly": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
