{
  "ConnectionStrings": {
    "TriviaBattle": "Data Source=triviabattle.db"
  },
  "AdminApiKey": "",
  "Port": 5000,

  "Game": {
    "MatchSeconds": 60,
    "IntroSeconds": 7,
    "ResultsSeconds": 10,
    "CorrectPoints": 100,
    "WrongAnswerPenalty": "Lockout",
    "LockoutSeconds": 2,
    "WrongAnswerPoints": 50,
    "NewQuestionGraceSeconds": 0.3,
    "ShuffleAnswers": true
  },

  "Display": {
    "DefaultTheme": "neon"
  },

  "Media": {
    "IntroVideoUrl": "/media/intro.webm",
    "IntroVideoDelaySeconds": 1
  },

  "Audio": {
    "Enabled": true,
    "OutputCount": 8,
    "SampleRate": 44100,
    "IntroSound": "",
    "LobbyMusic": "/media/audio/main_theme_music.mp3",
    "AttractMusic": "/media/audio/main_theme_music.mp3",
    "PlayingMusic": "/media/audio/ingame_music.mp3",
    "VictoryMusic": "/media/audio/victory_music.mp3",
    "CorrectStingers": [
      "/media/audio/stingers/success_1.wav",
      "/media/audio/stingers/success_2.wav",
      "/media/audio/stingers/success_3.wav"
    ],
    "WrongStingers": [
      "/media/audio/stingers/fail_1.wav",
      "/media/audio/stingers/fail_2.wav",
      "/media/audio/stingers/fail_3.wav"
    ],
    "MusicVolume": 0.8,
    "AttractVolume": 0.8,
    "IntroVolume": 1,
    "StingerVolume": 1,
    "SubVolume": 1
  },

  "Leaderboards": {
    "Size": 10,
    "RegisteredPlayersOnly": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
